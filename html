  <script>
    function showPage(pageId, event) {
      if (event) event.preventDefault();

      document.querySelectorAll('.page-view').forEach(function(view) {
        view.classList.remove('active');
      });

      var targetView = document.getElementById('view-' + pageId);
      if (targetView) {
        targetView.classList.add('active');
      }

      var mainNav = document.getElementById('main-nav');
      if (mainNav) {
        mainNav.style.display = (pageId === 'accueil') ? 'flex' : 'none';
      }

      window.scrollTo(0, 0);
      history.replaceState(null, '', '#' + pageId);
    }

    function navigateToSection(sectionId, event) {
      if (event) event.preventDefault();
      showPage('accueil');
      var target = document.getElementById(sectionId);
      if (target) {
        target.scrollIntoView({ behavior: 'auto' });
      }
    }

    window.addEventListener('DOMContentLoaded', function() {
      var hash = window.location.hash.replace('#', '');
      if (hash === 'mentions-rgpd' || hash === 'cgu') {
        showPage(hash);
      }
    });
  </script>

