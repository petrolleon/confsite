<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Colloque Intelligence Artificielle 2026 - Chabrillan Saint-Jean-Baptiste</title>
  <meta name="description" content="Colloque sur l'intelligence artificielle organisé par l'ensemble scolaire Chabrillan Saint-Jean-Baptiste, le lundi 14 décembre 2026 à Montélimar (salle Gisèle Didier)." />
  
  <!-- Favicon sobre aux couleurs de l'établissement -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2316325C'/%3E%3Ctext x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' font-family='Georgia, serif' font-weight='bold' font-size='19' fill='%23FFFFFF'%3EC%3C/text%3E%3C/svg%3E" />

  <style>
    :root {
      --bg-page: #FFFFFF;
      --bg-subtle: #F4F5F7;
      --bg-header: #16325C;
      --text-main: #1F242B;
      --text-muted: #525B66;
      --primary: #16325C;
      --primary-hover: #0F2342;
      --border: #D0D5DD;
      --border-dark: #98A2B3;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
    }

    a {
      color: var(--primary);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    /* Bandeau supérieur institutionnel */
    .top-bar {
      background-color: var(--bg-header);
      color: #FFFFFF;
      font-size: 0.85rem;
      padding: 0.5rem 0;
    }

    .container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .top-bar-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* En-tête principal */
    header {
      background-color: #FFFFFF;
      border-bottom: 2px solid var(--primary);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 1.5rem;
      max-width: 1040px;
      margin: 0 auto;
      gap: 1.5rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: var(--text-main);
    }

    .brand:hover {
      text-decoration: none;
    }

    .brand img {
      height: 48px;
      width: auto;
      object-fit: contain;
    }

    .brand-title {
      display: block;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.15rem;
      font-weight: bold;
      color: var(--primary);
      line-height: 1.2;
    }

    .brand-subtitle {
      display: block;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    nav.main-nav {
      display: flex;
      gap: 1.75rem;
    }

    nav.main-nav a {
      color: var(--text-main);
      font-size: 0.92rem;
      font-weight: 600;
    }

    nav.main-nav a:hover {
      color: var(--primary);
    }

    /* Gestion des vues */
    .page-view {
      display: none;
    }

    .page-view.active {
      display: block;
    }

    /* Bannière de présentation sobre */
    .event-banner {
      background-color: var(--bg-subtle);
      border-bottom: 1px solid var(--border);
      padding: 3rem 0;
    }

    .banner-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }

    .event-category {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--primary);
      margin-bottom: 0.75rem;
    }

    h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2.35rem;
      font-weight: normal;
      line-height: 1.2;
      color: var(--text-main);
      margin-bottom: 1rem;
    }

    .banner-desc {
      color: var(--text-muted);
      font-size: 1.02rem;
      margin-bottom: 1.75rem;
    }

    .btn-group {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #FFFFFF;
      padding: 0.75rem 1.35rem;
      font-size: 0.92rem;
      font-weight: 600;
      border: 1px solid var(--primary);
      border-radius: 3px;
      display: inline-block;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
      text-decoration: none;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: var(--primary);
      padding: 0.75rem 1.35rem;
      font-size: 0.92rem;
      font-weight: 600;
      border: 1px solid var(--border-dark);
      border-radius: 3px;
      display: inline-block;
    }

    .btn-secondary:hover {
      background-color: var(--bg-subtle);
      text-decoration: none;
    }

    /* Fiche pratique encadrée */
    .info-card {
      background-color: #FFFFFF;
      border: 1px solid var(--border);
      padding: 1.5rem;
    }

    .info-card-title {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.1rem;
      font-weight: bold;
      color: var(--primary);
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .info-list {
      list-style: none;
    }

    .info-list li {
      padding: 0.5rem 0;
      border-bottom: 1px solid #EAECF0;
      font-size: 0.92rem;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }

    .info-list li:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-label {
      color: var(--text-muted);
    }

    .info-value {
      font-weight: 600;
      text-align: right;
    }

    /* Sections de contenu */
    section.content-section {
      padding: 3.25rem 0;
      border-bottom: 1px solid var(--border);
    }

    .section-header {
      margin-bottom: 1.75rem;
    }

    h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.75rem;
      font-weight: normal;
      color: var(--primary);
      margin-bottom: 0.35rem;
    }

    .section-subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Tableau classique des intervenants */
    .speakers-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .speaker-card {
      border: 1px solid var(--border);
      padding: 1.25rem;
      background-color: #FFFFFF;
    }

    .speaker-role {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }

    .speaker-name {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.25rem;
    }

    .speaker-detail {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* Programme : Tableau horaire classique */
    .program-block {
      margin-bottom: 2.25rem;
    }

    .program-block:last-child {
      margin-bottom: 0;
    }

    .program-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid var(--border);
      font-size: 0.94rem;
    }

    .program-table caption {
      text-align: left;
      font-weight: 700;
      font-size: 1rem;
      color: var(--text-main);
      background-color: var(--bg-subtle);
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-bottom: none;
    }

    .program-table th,
    .program-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
    }

    .program-table th {
      width: 165px;
      font-weight: 600;
      color: var(--primary);
      background-color: #FAFBFD;
      border-right: 1px solid var(--border);
      white-space: nowrap;
    }

    .program-table tr.row-pause td,
    .program-table tr.row-pause th {
      background-color: var(--bg-subtle);
    }

    .prog-title {
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 0.2rem;
    }

    .prog-desc {
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    /* Grille partenaires */
    .partners-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
      gap: 1rem;
    }

    .partner-card {
      border: 1px solid var(--border);
      background-color: #FFFFFF;
      padding: 1.25rem 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 0.65rem;
    }

    .partner-logo {
      height: 52px;
      width: 130px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .partner-logo img {
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
    }

    .partner-fallback {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .partner-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-main);
    }

    /* Encadré inscription */
    .registration-panel {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border);
      border-left: 4px solid var(--primary);
      padding: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .registration-panel h3 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.45rem;
      font-weight: normal;
      color: var(--primary);
      margin-bottom: 0.35rem;
    }

    .registration-panel p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Pages légales */
    .legal-container {
      padding: 3rem 0 4rem;
      max-width: 780px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .legal-meta {
      color: var(--text-muted);
      font-size: 0.88rem;
      padding-bottom: 1.25rem;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }

    .legal-article h2 {
      font-size: 1.35rem;
      margin-top: 2rem;
      margin-bottom: 0.65rem;
    }

    .legal-article p,
    .legal-article ul {
      font-size: 0.95rem;
      margin-bottom: 0.9rem;
      color: var(--text-main);
    }

    .legal-article ul {
      padding-left: 1.5rem;
    }

    .legal-article li {
      margin-bottom: 0.4rem;
    }

    /* Pied de page */
    footer {
      background-color: var(--bg-subtle);
      border-top: 1px solid var(--border);
      padding: 2rem 0;
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--text-main);
    }

    @media (max-width: 820px) {
      .banner-grid {
        grid-template-columns: 1fr;
      }
      .speakers-grid {
        grid-template-columns: 1fr;
      }
      .header-inner {
        flex-direction: column;
        align-items: flex-start;
      }
      nav.main-nav {
        flex-wrap: wrap;
        gap: 1.25rem;
      }
    }

    @media (max-width: 600px) {
      .program-table th,
      .program-table td {
        display: block;
        width: 100%;
      }
      .program-table th {
        border-right: none;
        border-bottom: none;
        padding-bottom: 0.25rem;
      }
      .program-table td {
        padding-top: 0.25rem;
      }
    }
  </style>
</head>
<body>

  <div class="top-bar">
    <div class="container top-bar-inner">
      <span>Ensemble scolaire Chabrillan Saint-Jean-Baptiste · Montélimar</span>
      <span>Événement pédagogique · Lundi 14 décembre 2026</span>
    </div>
  </div>

  <header>
    <div class="header-inner">
      <a href="#accueil" onclick="showPage('accueil', event)" class="brand">
        <img src="/img/logo-chabrillan.png" alt="Logo Chabrillan Saint-Jean-Baptiste" onerror="this.style.display='none'" />
        <div>
          <span class="brand-title">Colloque Intelligence Artificielle 2026</span>
          <span class="brand-subtitle">Lycée Chabrillan Saint-Jean-Baptiste</span>
        </div>
      </a>
      <nav class="main-nav" id="main-nav">
        <a href="#intervenants" onclick="navigateToSection('intervenants', event)">Intervenants</a>
        <a href="#programme" onclick="navigateToSection('programme', event)">Programme</a>
        <a href="#partenaires" onclick="navigateToSection('partenaires', event)">Partenaires</a>
        <a href="#inscription" onclick="navigateToSection('inscription', event)">Inscription</a>
      </nav>
    </div>
  </header>

  <main>

    <!-- =========================================================
         PAGE D'ACCUEIL
         ========================================================= -->
    <div id="view-accueil" class="page-view active">
      
      <div class="event-banner">
        <div class="container banner-grid">
          <div>
            <span class="event-category">Journée d'étude et de conférences</span>
            <h1>Colloque sur l’Intelligence Artificielle</h1>
            <p class="banner-desc">Une journée dédiée à la compréhension des enjeux techniques, scientifiques et éducatifs de l'intelligence artificielle, réunissant professionnels du secteur, intervenants invités et lycéens.</p>
            <div class="btn-group">
              <a href="#inscription" class="btn-primary">S'inscrire à la journée</a>
              <a href="#programme" class="btn-secondary">Voir le programme détaillé</a>
            </div>
          </div>

          <aside class="info-card">
            <div class="info-card-title">Informations pratiques</div>
            <ul class="info-list">
              <li>
                <span class="info-label">Date</span>
                <span class="info-value">Lundi 14 décembre 2026</span>
              </li>
              <li>
                <span class="info-label">Horaires</span>
                <span class="info-value">08h30 à 16h30</span>
              </li>
              <li>
                <span class="info-label">Lieu</span>
                <span class="info-value">Salle Gisèle Didier, Montélimar</span>
              </li>
              <li>
                <span class="info-label">Public</span>
                <span class="info-value">Classes de 1ère et 2nde, invités</span>
              </li>
              <li>
                <span class="info-label">Entrée</span>
                <span class="info-value">Gratuite sur inscription</span>
              </li>
            </ul>
          </aside>
        </div>
      </div>

      <!-- Intervenants -->
      <section id="intervenants" class="content-section">
        <div class="container">
          <div class="section-header">
            <h2>Intervenants</h2>
            <p class="section-subtitle">Conférenciers invités et élèves participant aux présentations de la journée.</p>
          </div>

          <div class="speakers-grid">
            <div class="speaker-card">
              <div class="speaker-role">Conférencier</div>
              <div class="speaker-name">Jérôme Lecourtier</div>
              <div class="speaker-detail">Pixel Dorado : Approche scientifique et technique</div>
            </div>

            <div class="speaker-card">
              <div class="speaker-role">Conférencière</div>
              <div class="speaker-name">Juliette Piovesan</div>
              <div class="speaker-detail">Intervention de la matinée (09h15)</div>
            </div>

            <div class="speaker-card">
              <div class="speaker-role">Conférencière</div>
              <div class="speaker-name">Sophie Guibal</div>
              <div class="speaker-detail">Intervention de la matinée (10h30)</div>
            </div>

            <div class="speaker-card">
              <div class="speaker-role">Conférencier</div>
              <div class="speaker-name">Benjamin Rey</div>
              <div class="speaker-detail">Intervenant invité</div>
            </div>

            <div class="speaker-card" style="grid-column: 1 / -1;">
              <div class="speaker-role">Établissement scolaire</div>
              <div class="speaker-name">Élèves PMH et Lycéens</div>
              <div class="speaker-detail">Présentations élèves et animation des séquences (Ulysse, Marc, Alexandre, Paul)</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Programme -->
      <section id="programme" class="content-section">
        <div class="container">
          <div class="section-header">
            <h2>Programme de la journée</h2>
            <p class="section-subtitle">La matinée est consacrée aux classes de Première ; l'après-midi est consacrée aux classes de Seconde.</p>
          </div>

          <div class="program-block">
            <table class="program-table">
              <caption>Session du matin : Public des classes de Première</caption>
              <tbody>
                <tr>
                  <th>08h30 - 09h15</th>
                  <td>
                    <div class="prog-title">Discours d’ouverture et 1ère conférence</div>
                    <div class="prog-desc">Accueil par Ulysse, Marc, Alexandre et Paul, suivi de la première intervention.</div>
                  </td>
                </tr>
                <tr>
                  <th>09h15 - 10h00</th>
                  <td>
                    <div class="prog-title">2ème intervention : Juliette Piovesan</div>
                    <div class="prog-desc">Conférence et temps d’échange avec les élèves.</div>
                  </td>
                </tr>
                <tr class="row-pause">
                  <th>10h00 - 10h30</th>
                  <td>
                    <div class="prog-title">Pause et Mini-ateliers</div>
                    <div class="prog-desc">Démonstrations pratiques et échanges libres autour des mini-ateliers.</div>
                  </td>
                </tr>
                <tr>
                  <th>10h30 - 11h15</th>
                  <td>
                    <div class="prog-title">3ème intervention : Sophie Guibal</div>
                    <div class="prog-desc">Conférence thématique.</div>
                  </td>
                </tr>
                <tr>
                  <th>11h15 - 12h00</th>
                  <td>
                    <div class="prog-title">4ème intervention : PMH (Élèves)</div>
                    <div class="prog-desc">Restitution et prise de parole des élèves.</div>
                  </td>
                </tr>
                <tr class="row-pause">
                  <th>12h00 - 13h30</th>
                  <td>
                    <div class="prog-title">Pause déjeuner</div>
                    <div class="prog-desc">Restauration assurée par Sodexo.</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="program-block">
            <table class="program-table">
              <caption>Session de l'après-midi : Public des classes de Seconde</caption>
              <tbody>
                <tr>
                  <th>13h30 - 14h15</th>
                  <td>
                    <div class="prog-title">5ème intervention : Intervention élèves</div>
                    <div class="prog-desc">Ouverture de la session de l’après-midi pour les classes de Seconde.</div>
                  </td>
                </tr>
                <tr class="row-pause">
                  <th>14h15 - 15h30</th>
                  <td>
                    <div class="prog-title">Séquence intermédiaire et Pause</div>
                    <div class="prog-desc">Temps d’échange et pause de l’après-midi (15h00 à 15h30).</div>
                  </td>
                </tr>
                <tr>
                  <th>15h30 - 16h15</th>
                  <td>
                    <div class="prog-title">7ème intervention</div>
                    <div class="prog-desc">Conférence de clôture de l’après-midi.</div>
                  </td>
                </tr>
                <tr>
                  <th>16h15 - 16h30</th>
                  <td>
                    <div class="prog-title">Discours de fermeture</div>
                    <div class="prog-desc">Bilan de la journée et remerciements aux intervenants et partenaires.</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Partenaires -->
      <section id="partenaires" class="content-section">
        <div class="container">
          <div class="section-header">
            <h2>Partenaires et soutiens</h2>
            <p class="section-subtitle">Les entreprises et acteurs locaux qui accompagnent l'organisation de l'événement.</p>
          </div>

          <div class="partners-grid">
            <div class="partner-card">
              <div class="partner-logo"><img src="/img/logos/dca.png" alt="DCA" onerror="this.outerHTML='<span class=\'partner-fallback\'>DCA</span>'" /></div>
              <span class="partner-name">Entreprise DCA</span>
            </div>
            <div class="partner-card">
              <div class="partner-logo"><img src="/img/logos/hotel-du-centre.png" alt="Hôtel du Centre" onerror="this.outerHTML='<span class=\'partner-fallback\'>Hôtel du Centre</span>'" /></div>
              <span class="partner-name">Hôtel du Centre</span>
            </div>
            <div class="partner-card">
              <div class="partner-logo"><img src="/img/logos/gregori.png" alt="Gregori International" onerror="this.outerHTML='<span class=\'partner-fallback\'>Gregori</span>'" /></div>
              <span class="partner-name">Gregori International</span>
            </div>
            <div class="partner-card">
              <div class="partner-logo"><img src="/img/logos/axa.png" alt="AXA Assurance" onerror="this.outerHTML='<span class=\'partner-fallback\'>AXA</span>'" /></div>
              <span class="partner-name">AXA Assurance</span>
            </div>
            <div class="partner-card">
              <div class="partner-logo"><img src="/img/logos/freegun.png" alt="Freegun" onerror="this.outerHTML='<span class=\'partner-fallback\'>Freegun</span>'" /></div>
              <span class="partner-name">Freegun</span>
            </div>
            <div class="partner-card">
              <div class="partner-logo"><img src="/img/logos/pixel-dorado.png" alt="Pixel Dorado" onerror="this.outerHTML='<span class=\'partner-fallback\'>Pixel Dorado</span>'" /></div>
              <span class="partner-name">Pixel Dorado</span>
